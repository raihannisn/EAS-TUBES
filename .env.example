# ============================================
# BACKEND CONFIGURATION
# ============================================
API_PORT=8000
API_HOST=0.0.0.0

# ============================================
# BMKG API CONFIGURATION
# ============================================
# BMKG API URL untuk prakiraan cuaca
BMKG_API_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca

# ADM4 code untuk lokasi cuaca (default: Jakarta Pusat)
# Cari kode lokasi di BMKG catalog atau ubah sesuai kebutuhan
BMKG_ADM4=31.71.03.1001

# BMKG Maritime API URL untuk data maritim
BMKG_MARITIME_URL=https://api.bmkg.go.id/publik/prakiraan-maritim

# Kode maritime untuk lokasi (default: Jakarta - H.01)
BMKG_MARITIME_CODE=H.01

# ============================================
# OPTIONAL: OPENAI CONFIGURATION
# ============================================
# Jika ingin menggunakan OpenAI GPT untuk jawaban AI yang lebih canggih
# OPENAI_API_KEY=sk-xxx
